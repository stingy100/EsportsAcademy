@model IReadOnlyList<Jugador>
@{
    ViewData["Title"] = "Jugadores inscritos";
}

<div class="p-4 bg-white rounded border shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="h4 mb-0 text-dark">Jugadores Inscritos</h2>
        <div>
            <span class="badge bg-primary fs-6 me-2">Total: @Model.Count</span>
            <a class="btn btn-primary btn-sm" asp-action="Crear">+ Nuevo jugador</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center" role="alert">
            No hay participantes registrados aún.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Juego</th>
                        <th>Rol</th>
                        <th>Edad</th>
                        <th>Registro</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var j in Model)
                {
                    <tr>
                        <th scope="row">@j.Id</th>
                        <td class="fw-semibold">@j.Nombre</td>
                        <td><span class="badge bg-primary">@j.Juego</span></td>
                        <td>@j.Rol</td>
                        <td>@j.Edad</td>
                        <td>@j.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <form asp-action="Eliminar" asp-route-id="@j.Id" method="post"
                                  onsubmit="return confirm('¿Eliminar a @j.Nombre?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
